# Railway backend
# Railway usually injects PORT automatically.
PORT=8000

# Railway MySQL connection string.
# SQLAlchemy accepts mysql+pymysql://... directly.
# If Railway provides mysql://..., backend/database.py converts it automatically.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE

# Comma-separated frontend origins that may call this API.
# Put your real Vercel production URL here.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional: allow Vercel preview deployments.
# Use carefully; this allows any HTTPS subdomain under vercel.app.
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional DB startup retry tuning.
DB_INIT_RETRIES=20
DB_INIT_RETRY_DELAY=1.0

# Optional SQL query logging.
SQLALCHEMY_ECHO=0
