# Local backend
PORT=8000

# Local MySQL connection string.
DATABASE_URL=mysql+pymysql://root@localhost/mixindo_db

# Comma-separated frontend origins that may call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional DB startup retry tuning.
DB_INIT_RETRIES=20
DB_INIT_RETRY_DELAY=1.0

# Optional SQL query logging.
SQLALCHEMY_ECHO=0
